#!/usr/bin/env bash
# Displays the DNS record type and destination of the subdomains of a domain
show_subdomain () {
    dig "$2.$1" | grep -A1 'ANSWER SECTION:' | tail -1 | awk -v name="$2" '{print "The subdomain " name " is a " $4 " record and points to " $5}'
}

if [ "$#" -eq 1 ]; then
    for subdomain in www lb-01 web-01 web-02; do
        show_subdomain "$1" "$subdomain"
    done
else
    show_subdomain "$1" "$2"
fi
